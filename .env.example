# OpenAI Secure MCP Tunnel runtime credentials.
# CONTROL_PLANE_API_KEY needs Tunnels Read + Use.
CONTROL_PLANE_TUNNEL_ID=''
CONTROL_PLANE_API_KEY=''

# Bearer token of the one wacli-me tenant exposed by this tunnel.
# Use the same value as that tenant's "token" in config/tenants.json.
WACLI_ME_TENANT_TOKEN=''

# Bind-mounted data is written by the container process. On Linux, set these
# to the values from `id -u` and `id -g` so the files stay editable by you.
WACLI_UID=10001
WACLI_GID=10001

# Optional host-local UI ports.
WACLI_ME_LOCAL_PORT=8787
TUNNEL_UI_PORT=8092
